{
  "manifest_version": 3,
  "name": "LinkedIn Comment Scraper",
  "version": "1.0",
  "description": "Scrape comments from LinkedIn posts and export them to a CSV file.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["scraper.js"]
    }
  ]
} 