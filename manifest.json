{
  "manifest_version": 3,
  "name": "LinkedIn Comment Scraper",
  "version": "1.0",
  "description": "Scrape comments from LinkedIn posts and export them as CSV",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://docs.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["scraper.js"]
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["sheets-helper.js"]
    }
  ]
} 